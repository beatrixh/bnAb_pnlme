DEFINITION:
L = {distribution=logNormal, typical=L_pop, covariate=goes_down, coefficient={0, beta_L_goes_down_True}, no-variability}
U = {distribution=logNormal, typical=U_pop, no-variability}
alpha = {distribution=logNormal, typical=alpha_pop, covariate=run_id, coefficient={0, beta_alpha_run_id_1313842, beta_alpha_run_id_1313860, beta_alpha_run_id_1313884, beta_alpha_run_id_1313920, beta_alpha_run_id_1313938, beta_alpha_run_id_1313956, beta_alpha_run_id_1313974, beta_alpha_run_id_1313992, beta_alpha_run_id_1314016, beta_alpha_run_id_1314040, beta_alpha_run_id_1314058, beta_alpha_run_id_1342240, beta_alpha_run_id_1342258, beta_alpha_run_id_1342276, beta_alpha_run_id_1342294, beta_alpha_run_id_1342312, beta_alpha_run_id_1342336, beta_alpha_run_id_1342348, beta_alpha_run_id_1342372, beta_alpha_run_id_1342384, beta_alpha_run_id_1342396, beta_alpha_run_id_1342408}, no-variability}
e = {distribution=logNormal, typical=e_pop, covariate=goes_down, coefficient={0, beta_e_goes_down_True}, sd=omega_e}
k = {distribution=logNormal, typical=k_pop, covariate=run_id, coefficient={0, beta_k_run_id_1313842, beta_k_run_id_1313860, beta_k_run_id_1313884, beta_k_run_id_1313920, beta_k_run_id_1313938, beta_k_run_id_1313956, beta_k_run_id_1313974, beta_k_run_id_1313992, beta_k_run_id_1314016, beta_k_run_id_1314040, beta_k_run_id_1314058, beta_k_run_id_1342240, beta_k_run_id_1342258, beta_k_run_id_1342276, beta_k_run_id_1342294, beta_k_run_id_1342312, beta_k_run_id_1342336, beta_k_run_id_1342348, beta_k_run_id_1342372, beta_k_run_id_1342384, beta_k_run_id_1342396, beta_k_run_id_1342408}, no-variability}
m = {distribution=normal, typical=m_pop, covariate=goes_down, coefficient={0, beta_m_goes_down_True}, sd=omega_m}
s = {distribution=normal, typical=s_pop, covariate=goes_down, coefficient={0, beta_s_goes_down_True}, no-variability}

[LONGITUDINAL]
input = {a, b}

file = '../5PL_edge_effects_2026-07-28.txt'

DEFINITION:
rlu_norm = {distribution=normal, prediction=f_edge, errorModel=combined1(a, b)}

