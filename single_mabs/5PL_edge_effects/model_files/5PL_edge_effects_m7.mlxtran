<DATAFILE>

[FILEINFO]
file={path='../../input_data/atlas_data_single_mabs_with_plate_locs_2026-07-30.csv'}
delimiter = comma
header={run_id, run_name, id_unique, plate_row, plate_col, rlu, min_diff, specrole, run, virus_name, virus_id, concentration, monolix_id, rlu_max, rlu_min, rlu_norm, virus_col, mab, mablot, mab_virus, goes_down, virus_cc}

[CONTENT]
run_id = {use=covariate, type=categorical}
plate_row = {use=regressor}
plate_col = {use=regressor}
concentration = {use=time}
monolix_id = {use=identifier}
rlu_norm = {use=observation, type=continuous}
mab_virus = {use=covariate, type=categorical}
goes_down = {use=covariate, type=categorical}
virus_cc = {use=regressor}

<MODEL>

[COVARIATE]
input = {goes_down, run_id, mab_virus}

goes_down = {type=categorical, categories={'False', 'True'}}
run_id = {type=categorical, categories={'1200432', '1313842', '1313860', '1313884', '1313920', '1313938', '1313956', '1313974', '1313992', '1314016', '1314040', '1314058', '1342240', '1342258', '1342276', '1342294', '1342312', '1342336', '1342348', '1342372', '1342384', '1342396', '1342408'}}
mab_virus = {type=categorical, categories={'Clinical VRC01|PVO.4', 'PGDM1400|1176', 'PGDM1400|1798', 'PGDM1400|2944', 'PGDM1400|2946', 'PGDM1400|3430', 'PGDM1400|4166', 'PGDM1400|4168', 'PGDM1400|Ce1176_A3', 'PGDM1400|PVO.4', 'PGDM1400|RHPA4259.7', 'PGDM1400|TRO.11', 'PGT121|1176', 'PGT121|1798', 'PGT121|2944', 'PGT121|2946', 'PGT121|3430', 'PGT121|4166', 'PGT121|4168', 'PGT121|Ce1176_A3', 'PGT121|PVO.4', 'PGT121|RHPA4259.7', 'PGT121|TRO.11', 'VRC07-523LS|1176', 'VRC07-523LS|1798', 'VRC07-523LS|2944', 'VRC07-523LS|2946', 'VRC07-523LS|3430', 'VRC07-523LS|4166', 'VRC07-523LS|4168', 'VRC07-523LS|Ce1176_A3', 'VRC07-523LS|PVO.4', 'VRC07-523LS|RHPA4259.7', 'VRC07-523LS|TRO.11', 'nan|1176', 'nan|1798', 'nan|2944', 'nan|2946', 'nan|3430', 'nan|4166', 'nan|4168', 'nan|Ce1176_A3', 'nan|PVO.4', 'nan|RHPA4259.7', 'nan|TRO.11'}}

[INDIVIDUAL]
